# Cross toolchain for the Windows UMD and guest probes (x86_64, MinGW-w64 GCC from the dev shell).
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

if(DEFINED ENV{VGD_MINGW_MCFG_INCLUDE})
  set(CMAKE_C_FLAGS_INIT "-isystem $ENV{VGD_MINGW_MCFG_INCLUDE}")
  set(CMAKE_CXX_FLAGS_INIT "-isystem $ENV{VGD_MINGW_MCFG_INCLUDE}")
endif()
if(DEFINED ENV{VGD_MINGW_MCFG_LIB})
  set(CMAKE_EXE_LINKER_FLAGS_INIT "-L$ENV{VGD_MINGW_MCFG_LIB}")
  set(CMAKE_SHARED_LINKER_FLAGS_INIT "-L$ENV{VGD_MINGW_MCFG_LIB}")
endif()
