# SPDX-License-Identifier: MIT
# Extracts the member names of DDI function tables from the WDK/SDK headers into an X-macro header, so every slot
# gets a logging stub without restating Microsoft's tables in our sources. Only names are extracted; slot types come
# from decltype() on the real structs at compile time.
#
#   vgd_generate_ddi_slots(OUTPUT <file> TABLES <macro> <header> <struct> [<macro> <header> <struct> ...])
#
# emits, per table:  #define <macro>(X) X(pfnFirst) X(pfnSecond) ...
function(vgd_generate_ddi_slots)
  cmake_parse_arguments(ARG "" "OUTPUT" "TABLES" ${ARGN})
  set(out "// Generated by cmake/ddi_slots.cmake from the WDK/SDK headers. Do not edit.\n#pragma once\n")
  list(LENGTH ARG_TABLES n)
  math(EXPR last "${n} - 1")
  foreach(i RANGE 0 ${last} 3)
    math(EXPR ih "${i} + 1")
    math(EXPR is "${i} + 2")
    list(GET ARG_TABLES ${i} macro)
    list(GET ARG_TABLES ${ih} header)
    list(GET ARG_TABLES ${is} struct)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")

    file(READ "${header}" text)
    string(FIND "${text}" "typedef struct ${struct}\n" begin)
    if(begin EQUAL -1)
      string(FIND "${text}" "typedef struct ${struct}\r\n" begin)
    endif()
    if(begin EQUAL -1)
      message(FATAL_ERROR "ddi_slots: ${struct} not found in ${header}")
    endif()
    string(SUBSTRING "${text}" ${begin} -1 text)
    string(REGEX MATCH "^.*}[ \t]*${struct}[ \t]*;" body "${text}")
    if(NOT body)
      message(FATAL_ERROR "ddi_slots: end of ${struct} not found in ${header}")
    endif()
    # Members only rasterization-only (D3D10PSGP) builds of the header have.
    string(REGEX REPLACE "#ifdef D3D10PSGP[^#]*#endif" "" body "${body}")
    # Drop comments, then take every pfn member name: "PFN_X pfnName;" and "(__stdcall * pfnName )(...)".
    string(REGEX REPLACE "//[^\n]*" "" body "${body}")
    # ";" separates CMake list items, so it is replaced before matching.
    string(REPLACE ";" "@" body "${body}")
    string(REGEX MATCHALL "pfn[A-Za-z0-9_]+[ \t]*[@)]" slots "${body}")
    set(line "#define ${macro}(X)")
    set(count 0)
    foreach(s IN LISTS slots)
      string(REGEX REPLACE "[ \t@)]" "" s "${s}")
      string(APPEND line " \\\n    X(${s})")
      math(EXPR count "${count} + 1")
    endforeach()
    string(APPEND out "\n// ${struct}: ${count} slots\n${line}\n")
  endforeach()

  if(EXISTS "${ARG_OUTPUT}")
    file(READ "${ARG_OUTPUT}" old)
  endif()
  if(NOT "${old}" STREQUAL "${out}")
    file(WRITE "${ARG_OUTPUT}" "${out}")
  endif()
endfunction()
