# Run by the build (setup/CMakeLists.txt): stamps pkg/vgd.inf with the version and the build, packs it with the files
# it lists into payload.cab, and writes payload.rc, which puts the cabinet, the version and Windows' version
# information into vgd-setup.exe.
#   cmake -DSOURCE_DIR= -DOUT_DIR= -DVERSION=x.y.z -DGIT= -DGCAB= -DFILES=a;b -P payload.cmake
#
# The version is VERSION (the project's), the commit count, so each commit on main ranks above the one before it, and
# the abbreviated commit hash: 0.1.0.97.8ba40fd. DriverVer and the version resource take four numbers and leave the
# hash out. The build line in the INF makes every build a package of its own in the driver store, also two builds of
# one commit.
execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-list --count HEAD
                OUTPUT_VARIABLE count OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE r ERROR_QUIET)
if(NOT r EQUAL 0)
  set(count 0)
endif()
execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" describe --always --dirty --abbrev=10
                OUTPUT_VARIABLE describe OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
execute_process(COMMAND "${GIT}" -C "${SOURCE_DIR}" rev-parse --short=7 HEAD
                OUTPUT_VARIABLE hash OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE r ERROR_QUIET)
if(NOT r EQUAL 0)
  set(hash 0000000)
endif()
set(number "${VERSION}.${count}")
set(version "${number}.${hash}")
string(TIMESTAMP date "%m/%d/%Y" UTC)
string(TIMESTAMP now "%Y-%m-%dT%H:%M:%SZ" UTC)

set(pkg "${OUT_DIR}/package")
file(REMOVE_RECURSE "${pkg}")
file(MAKE_DIRECTORY "${pkg}")
file(READ "${SOURCE_DIR}/pkg/vgd.inf" inf)
string(REPLACE "\r" "" inf "${inf}")
string(REGEX REPLACE "\nDriverVer *=[^\n]*" "\n; Built from ${describe} at ${now}.\nDriverVer   = ${date},${number}"
       stamped "${inf}")
if(stamped STREQUAL inf)
  message(FATAL_ERROR "pkg/vgd.inf has no DriverVer line")
endif()
string(REPLACE "\n" "\r\n" stamped "${stamped}")
file(WRITE "${pkg}/vgd.inf" "${stamped}")
set(names vgd.inf)
foreach(f IN LISTS FILES)
  get_filename_component(name "${f}" NAME)
  file(COPY_FILE "${f}" "${pkg}/${name}")
  list(APPEND names "${name}")
endforeach()

execute_process(COMMAND "${GCAB}" --create --nopath --zip "${OUT_DIR}/payload.cab.tmp" ${names}
                WORKING_DIRECTORY "${pkg}" RESULT_VARIABLE r)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "gcab failed")
endif()
file(RENAME "${OUT_DIR}/payload.cab.tmp" "${OUT_DIR}/payload.cab")

string(REPLACE "." "," commas "${number}")
file(WRITE "${OUT_DIR}/version.txt" "${version}\n")
file(WRITE "${OUT_DIR}/payload.rc.tmp" "// Generated by setup/payload.cmake.
#include <winver.h>
1 RCDATA \"${OUT_DIR}/payload.cab\"
STRINGTABLE
BEGIN
  1 \"${version}\"
  2 \"${describe}\"
END
1 VERSIONINFO
FILEVERSION ${commas}
PRODUCTVERSION ${commas}
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK \"StringFileInfo\"
  BEGIN
    BLOCK \"040904B0\"
    BEGIN
      VALUE \"CompanyName\", \"vgd project\"
      VALUE \"FileDescription\", \"vgd Setup\"
      VALUE \"FileVersion\", \"${version}\"
      VALUE \"ProductName\", \"vgd\"
      VALUE \"ProductVersion\", \"${version} (${describe})\"
      VALUE \"OriginalFilename\", \"vgd-setup.exe\"
    END
  END
  BLOCK \"VarFileInfo\"
  BEGIN
    VALUE \"Translation\", 0x409, 1200
  END
END
")
file(COPY_FILE "${OUT_DIR}/payload.rc.tmp" "${OUT_DIR}/payload.rc" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT_DIR}/payload.rc.tmp")
