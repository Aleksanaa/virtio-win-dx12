--- a/src/virtio/vulkan/vn_instance.c
+++ b/src/virtio/vulkan/vn_instance.c
@@ -130,15 +130,54 @@
    return VK_SUCCESS;
 }
 
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+void
+vn_instance_reap_ring_indices(struct vn_instance *instance)
+{
+   mtx_lock(&instance->ring_idx_mutex);
+   for (uint32_t i = 1; i < ARRAY_SIZE(instance->ring_idx_retired_seqno); i++) {
+      const uint64_t bit = UINT64_C(1) << i;
+      if ((instance->ring_idx_retired_mask & bit) &&
+          vn_ring_get_seqno_status(instance->ring.destroy_ring,
+                                    instance->ring_idx_retired_seqno[i])) {
+         instance->ring_idx_retired_mask &= ~bit;
+         instance->ring_idx_used_mask &= ~bit;
+      }
+   }
+   mtx_unlock(&instance->ring_idx_mutex);
+}
+
+void
+vn_instance_release_ring_idx_deferred(struct vn_instance *instance,
+                                      uint32_t ring_idx,
+                                      uint32_t seqno)
+{
+   assert(ring_idx > 0 && ring_idx < 64);
+   mtx_lock(&instance->ring_idx_mutex);
+   assert(instance->ring_idx_used_mask & (UINT64_C(1) << ring_idx));
+   instance->ring_idx_retired_seqno[ring_idx] = seqno;
+   instance->ring_idx_retired_mask |= UINT64_C(1) << ring_idx;
+   mtx_unlock(&instance->ring_idx_mutex);
+}
+#endif
+
 static inline void
 vn_instance_fini_ring(struct vn_instance *instance)
 {
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+   if (instance->ring.destroy_ring)
+      vn_ring_wait_all(instance->ring.destroy_ring);
+#endif
    vn_watchdog_fini(&instance->ring.watchdog);
 
    list_for_each_entry_safe(struct vn_tls_ring, tls_ring,
                             &instance->ring.tls_rings, vk_head)
       vn_tls_destroy_ring(tls_ring);
 
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+   if (instance->ring.destroy_ring)
+      vn_ring_destroy(instance->ring.destroy_ring);
+#endif
    vn_ring_destroy(instance->ring.ring);
 }
 
