+static void
+vn_device_destroy_host(struct vn_device *dev, bool wait)
+{
+   const VkDevice device = vn_device_to_handle(dev);
+   struct vn_ring_submit_command submit = {0};
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+   (void)wait;
+   /* Native destruction can wait for work on another device. Its future
+    * signals must still be able to pass through the primary ring.
+    */
+   vn_ring_wait_all(dev->primary_ring);
+   vn_submit_vkDestroyDevice(dev->instance->ring.destroy_ring, 0, device,
+                              NULL, &submit);
+   const bool deferred = submit.ring_seqno_valid;
+   if (!deferred)
+#endif
+      vn_submit_vkDestroyDevice(dev->primary_ring, 0, device, NULL, &submit);
+
+#ifdef VK_USE_PLATFORM_WIN32_KHR
+   /* This mask also contains indices acquired before queue setup failed. */
+   for (uint32_t i = 1; i < 64; i++) {
+      if (!(dev->queue_ring_mask & (UINT64_C(1) << i)))
+         continue;
+      if (deferred)
+         vn_instance_release_ring_idx_deferred(dev->instance, i,
+                                                submit.ring_seqno);
+      else
+         vn_instance_release_ring_idx(dev->instance, i);
+   }
+   dev->queue_ring_mask = 0;
+#else
+   if (wait && submit.ring_seqno_valid)
+      vn_ring_wait_seqno(dev->primary_ring, submit.ring_seqno);
+#endif
+}
+
