+/* GPU-ordered signals of D3DKMT monitored fences (vn_queue.c's
+ * vkQueueSignalFenceVGD).
+ *
+ * A timeline packet on ring_idx completes when the work submitted to the host
+ * queue bound to it before the packet does; the Windows scheduler signals the
+ * fence once the packet completes, as it is queued behind it on our context.
+ */
+VkResult
+vn_renderer_d3dkmt_open_fence(struct vn_renderer *renderer, HANDLE nt_handle,
+                              uint32_t *out_fence)
+{
+   struct virtgpu *gpu = (struct virtgpu *)renderer;
+   if (!gpu->pfnOpenSyncObjectFromNtHandle2 ||
+       !gpu->pfnSignalSynchronizationObjectFromGpu)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   D3DKMT_OPENSYNCOBJECTFROMNTHANDLE2 open = {0};
+   open.hNtHandle = nt_handle;
+   open.hDevice = gpu->hDevice;
+   NTSTATUS status = gpu->pfnOpenSyncObjectFromNtHandle2(&open);
+   if (!NT_SUCCESS(status)) {
+      mesa_logw("venus: D3DKMTOpenSyncObjectFromNtHandle2(%p) failed "
+                "status=0x%lx", nt_handle, (unsigned long)status);
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   }
+   *out_fence = (uint32_t)open.hSyncObject;
+   return VK_SUCCESS;
+}
+
+void
+vn_renderer_d3dkmt_close_fence(struct vn_renderer *renderer, uint32_t fence)
+{
+   virtgpu_syncobj_destroy((struct virtgpu *)renderer, fence);
+}
+
+VkResult
+vn_renderer_d3dkmt_signal_fence(struct vn_renderer *renderer,
+                                uint32_t ring_idx, const void *cs_data,
+                                size_t cs_size, uint32_t fence,
+                                uint64_t value)
+{
+   struct virtgpu *gpu = (struct virtgpu *)renderer;
+   /* The kernel driver takes timeline packets with protocol bytes only. */
+   if (!ring_idx || !cs_size)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   mtx_lock(&gpu->render_mutex);
+   VkResult result = VK_ERROR_DEVICE_LOST;
+   const size_t cmd_size = sizeof(VIOGPU_COMMAND_HDR) +
+                           sizeof(VIOGPU_TIMELINE_SUBMIT) + cs_size;
+   if (!virtgpu_submit_ctx_init(gpu) || d3dkmt_submit_resize(gpu, cmd_size, 0))
+      goto out;
+
+   VIOGPU_COMMAND_HDR *hdr = (VIOGPU_COMMAND_HDR *)gpu->command_buffer;
+   hdr->type = VIOGPU_CMD_SUBMIT_TIMELINE;
+   hdr->size = (UINT)(sizeof(VIOGPU_TIMELINE_SUBMIT) + cs_size);
+   VIOGPU_TIMELINE_SUBMIT *timeline = (VIOGPU_TIMELINE_SUBMIT *)(hdr + 1);
+   timeline->RingIndex = ring_idx;
+   timeline->Reserved = 0;
+   memcpy(timeline + 1, cs_data, cs_size);
+
+   D3DKMT_RENDER render = {0};
+   render.hContext = gpu->hContext;
+   render.CommandLength = (UINT)cmd_size;
+   NTSTATUS status = gpu->pfnRender(&render);
+   if (!NT_SUCCESS(status)) {
+      vn_log(gpu->instance, "failed to submit timeline packet: %lx", status);
+      goto out;
+   }
+   if (render.pNewCommandBuffer)
+      gpu->command_buffer = render.pNewCommandBuffer;
+   if (render.NewCommandBufferSize)
+      gpu->command_buffer_size = render.NewCommandBufferSize;
+   if (render.pNewAllocationList)
+      gpu->allocation_list = render.pNewAllocationList;
+   if (render.NewAllocationListSize)
+      gpu->allocation_list_size = render.NewAllocationListSize;
+   if (render.pNewPatchLocationList)
+      gpu->patch_location_list = render.pNewPatchLocationList;
+   if (render.NewPatchLocationListSize)
+      gpu->patch_location_list_size = render.NewPatchLocationListSize;
+
+   const D3DKMT_HANDLE handle = (D3DKMT_HANDLE)fence;
+   D3DKMT_SIGNALSYNCHRONIZATIONOBJECTFROMGPU signal = {0};
+   signal.hContext = gpu->hContext;
+   signal.ObjectCount = 1;
+   signal.ObjectHandleArray = &handle;
+   signal.MonitoredFenceValueArray = &value;
+   status = gpu->pfnSignalSynchronizationObjectFromGpu(&signal);
+   if (!NT_SUCCESS(status)) {
+      vn_log(gpu->instance, "failed to signal fence %u from GPU: %lx", fence,
+             status);
+      goto out;
+   }
+   result = VK_SUCCESS;
+out:
+   mtx_unlock(&gpu->render_mutex);
+   return result;
+}
