+#ifdef VK_USE_PLATFORM_WIN32_KHR
+/* Private entry points (vkGetDeviceProcAddr) for a D3D driver over this one:
+ * a D3DKMT monitored fence that the GPU signals once the work submitted to a
+ * queue so far completes. Windows' scheduler can hold a present behind it,
+ * which the host queue's completion is otherwise invisible to.
+ */
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_OpenFenceVGD(VkDevice device, HANDLE nt_handle, uint32_t *pFence)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   return vn_renderer_d3dkmt_open_fence(dev->renderer, nt_handle, pFence);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+vn_CloseFenceVGD(VkDevice device, uint32_t fence)
+{
+   struct vn_device *dev = vn_device_from_handle(device);
+   vn_renderer_d3dkmt_close_fence(dev->renderer, fence);
+}
+
+/* VK_NOT_READY if nothing was submitted to the queue yet. */
+VKAPI_ATTR VkResult VKAPI_CALL
+vn_QueueSignalFenceVGD(VkQueue _queue, uint32_t fence, uint64_t value)
+{
+   struct vn_queue *queue = vn_queue_from_handle(_queue);
+   struct vn_device *dev = vn_device_from_vk(queue->base.vk.base.device);
+
+   simple_mtx_lock(&queue->submission_mutex);
+   VkResult result = VK_NOT_READY;
+   if (queue->last_ring_seqno_valid) {
+      /* The host executes the submissions from the ring; the packet must
+       * reach the queue after them.
+       */
+      uint32_t local_data[8];
+      struct vn_cs_encoder enc =
+         VN_CS_ENCODER_INITIALIZER_LOCAL(local_data, sizeof(local_data));
+      vn_encode_vkWaitRingSeqnoMESA(&enc, 0, vn_ring_get_id(dev->primary_ring),
+                                    queue->last_ring_seqno);
+      result = vn_renderer_d3dkmt_signal_fence(
+         dev->renderer, queue->ring_idx, local_data,
+         vn_cs_encoder_get_len(&enc), fence, value);
+   }
+   simple_mtx_unlock(&queue->submission_mutex);
+   return result;
+}
+#endif
